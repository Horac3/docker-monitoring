# Copy this to .env and fill in your values
# Never commit .env to version control!

# ── Email alerts ──────────────────────────────────────────────────────────
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
ALERT_TO=you@gmail.com

# ── SSL / Let's Encrypt ───────────────────────────────────────────────────
LETSENCRYPT_EMAIL=you@gmail.com
